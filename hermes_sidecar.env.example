# ============================================================================
# Hermes SIDECAR environment (a SEPARATE process from the backend)
# This file's values go in the Hermes profile's .env — NOT backend/.env:
#   Windows native:   %LOCALAPPDATA%\hermes\.env
#   Linux/macOS/WSL:  ~/.hermes/.env
# Find the exact path with:  hermes config env-path
# ============================================================================

# --- Model the agent thinks with ---
# Reuse the SAME Gemini key as the backend (or use a separate one).
# ONE key or a COMMA-SEPARATED list.
GEMINI_API_KEY=

# --- OpenAI-compatible API server that the backend calls ---
API_SERVER_ENABLED=true
# [REQUIRED] strong secret; MUST match HERMES_API_KEY in backend/.env.
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
API_SERVER_KEY=
API_SERVER_HOST=127.0.0.1            # keep loopback; do not expose publicly
API_SERVER_PORT=8642

# ----------------------------------------------------------------------------
# The model + toolset are config (not env). On the sidecar, also run once:
#   hermes config set model gemini-2.5-flash
#   hermes tools disable --platform api_server terminal browser code_execution \
#     delegation cronjob file image_gen vision todo session_search
#   (leaves: web, skills, memory)
# Then: hermes gateway
# ----------------------------------------------------------------------------
