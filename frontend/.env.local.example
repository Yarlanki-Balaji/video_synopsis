# Copy to .env.local (gitignored). Lives in frontend/, NOT frontend/src/.
# Backend origin that next.config.ts rewrites proxy /api and /auth to.
# Local dev: the FastAPI server. Production (Vercel): your Render backend URL.
#
# IMPORTANT: Next inlines rewrite destinations at BUILD time, so on Vercel this
# MUST be set as a build-time env var (not just runtime), e.g.
#   BACKEND_ORIGIN=https://video-synopsis-api.onrender.com
# If it's missing at build time, production proxies to http://localhost:8000 and
# every /api and /auth call fails.
BACKEND_ORIGIN=http://localhost:8000

# [optional] Direct base URL for API calls from the browser. Leave EMPTY to use
# the same-origin /api proxy above (recommended — keeps auth cookies first-party).
# Only set this if you intentionally bypass the proxy.
# NEXT_PUBLIC_API_URL=

# "Sign in with Google" button (login-only). Same OAuth Web client ID as the
# backend's GOOGLE_CLIENT_ID. Unset -> the button is hidden. Restart `npm run dev`
# after changing (NEXT_PUBLIC_* is baked at build/start time).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
