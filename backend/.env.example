# Copy to .env and fill in. .env is gitignored — never commit real secrets.
ENVIRONMENT=development
APP_NAME=video-synopsis-api

# Frontend origins allowed by CORS *and* the CSRF origin check (comma-separated).
CORS_ORIGINS=http://localhost:3000

# --- Auth / JWT ---
# Generate a strong one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production — the app refuses to boot there with the default.
JWT_SECRET=dev-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
INVITE_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60
# Cookie SameSite: "lax" locally; cross-site prod (different domains) needs "none".
COOKIE_SAMESITE=lax

# --- Email (B6) ---
# Unset -> invite/reset links are printed to the server log (fine for local dev).
# RESEND_API_KEY=re_xxx
EMAIL_FROM=Video Synopsis <onboarding@resend.dev>
PUBLIC_APP_URL=http://localhost:3000

# --- Groq / LLM (M2) ---
# No key -> a deterministic dev stub is used so the pipeline runs locally.
# (Reset dev.db after adding a real key so cached '[stub]' summaries are dropped.)
# GROQ_API_KEY=gsk_xxx
GROQ_MODEL=openai/gpt-oss-120b

# --- Quotas / circuit breaker (Postgres-authoritative, F5) ---
PER_USER_DAILY_JOBS=10
GLOBAL_DAILY_JOBS=50
GLOBAL_DAILY_TOKENS=200000

# --- Aiven (leave blank for local SQLite; /healthz works without them) ---
# Note: asyncpg handles SSL via connect args, not the URL's ?sslmode= param —
# that gets sorted out in M2 when the job ledger lands.
# DATABASE_URL=postgresql://avnadmin:password@pg-host.aivencloud.com:12345/defaultdb
# VALKEY_URL=rediss://default:password@valkey-host.aivencloud.com:12345
