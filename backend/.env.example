# ============================================================================
# video_synopsis_ai — BACKEND environment
# Copy to backend/.env and fill in values. .env is gitignored — never commit secrets.
# pydantic-settings reads these (names are case-insensitive). Anything left unset
# falls back to the default in app/config.py. Markers: [REQUIRED], [prod], [optional].
# ============================================================================

# --- App ---
ENVIRONMENT=development              # development | production  ([prod] enforces JWT_SECRET + email)
APP_NAME=video-synopsis-api

# --- CORS / CSRF (comma-separated frontend origins; no "*") ---
CORS_ORIGINS=http://localhost:3000

# --- Auth / JWT ---
# [REQUIRED in prod] Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=1440
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
COOKIE_SAMESITE=lax                  # lax (default) | none (+HTTPS for cross-origin)

# --- Google sign-in ([optional]; unset disables the Google button) ---
GOOGLE_CLIENT_ID=

# --- Email ([optional] locally — links print to log; [REQUIRED in prod]) ---
# Brevo takes priority over Resend when both are set.
RESEND_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Video Synopsis
EMAIL_FROM=Video Synopsis <onboarding@resend.dev>
PUBLIC_APP_URL=http://localhost:3000

# --- Database ([optional]; blank = local SQLite ./dev.db) ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=
DATABASE_SSL_CA=                     # path to CA cert for managed PG (e.g. Aiven verify-full)
VALKEY_URL=                          # rediss://default:password@host:port  ([optional])

# --- LLM: summarizer backend ---
LLM_PROVIDER=auto                    # auto (Gemini if key set, else Groq) | gemini | groq
LLM_TEMPERATURE=0.3
LLM_MAX_COMPLETION_TOKENS=3000

# Gemini (primary; 1M-token context). ONE key or a COMMA-SEPARATED list (rotates on 429).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_MAX_INPUT_TOKENS=900000

# Groq (alternative; no key -> deterministic dev stub so the pipeline still runs)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TPM_LIMIT=8000

# --- Transcript / audio / upload ---
# local   -> direct caption fetch (works on a residential/local IP)
# managed -> call a managed transcript API ([REQUIRED on cloud IPs] e.g. Render —
#            the direct fetch is IP-blocked there). Supadata-compatible.
TRANSCRIPT_PROVIDER=local            # local | managed
TRANSCRIPT_API_KEY=                  # [REQUIRED if managed] managed-provider API key
TRANSCRIPT_API_URL=https://api.supadata.ai/v1/transcript   # override for another vendor
YOUTUBE_API_KEY=                     # [optional] title/duration metadata only
TRANSCRIPT_MIN_CHARS=50
TRANSCRIPT_MAX_CHARS=200000
AUDIO_FALLBACK_ENABLED=true
UPLOAD_ENABLED=true
MAX_UPLOAD_MB=200

# --- Quotas / circuit breaker ---
PER_USER_DAILY_JOBS=10
GLOBAL_DAILY_JOBS=50
GLOBAL_DAILY_TOKENS=200000
