# Copy to .env and fill in. .env is gitignored — never commit real secrets.
ENVIRONMENT=development
APP_NAME=video-synopsis-api

# Frontend origins allowed by CORS (comma-separated).
CORS_ORIGINS=http://localhost:3000

# --- Aiven (leave blank until provisioned; /healthz works without them) ---
# Aiven Postgres. Note: asyncpg handles SSL via connect args, not the URL's
# ?sslmode= param — that gets sorted out in M2 when the job ledger lands.
# DATABASE_URL=postgresql://avnadmin:password@pg-host.aivencloud.com:12345/defaultdb

# Aiven Valkey (Redis-compatible).
# VALKEY_URL=rediss://default:password@valkey-host.aivencloud.com:12345
